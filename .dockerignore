# VCS / IDE
.git
.gitignore
.cursor
.vscode
.idea
*.md
!README.md

# Dependencies & build output (multi-stage rebuilds dist; runtime image needs it)
node_modules
coverage
.turbo
.cache

# Env / secrets
.env
.env.*
!.env.example

# Tests & tooling noise
**/*.test.ts
**/*.test.tsx
**/__tests__
vitest.config.*
eslint.config.*
*.log

# Docker meta (avoid recursive context bloat)
Dockerfile*
docker-compose*.yml
.dockerignore

# Misc
agent-transcripts
terminals
*.tsbuildinfo
