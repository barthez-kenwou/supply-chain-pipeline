# Image source
HARBOR_REGISTRY=harbor.example.com
HARBOR_PROJECT=zenora
IMAGE_TAG=sha-abcdef0
# Production: always set by remote-deploy.sh as registry/project/name@sha256:...
# IMAGE_REF=

# Docker network shared with Nginx Proxy Manager (no host port bind)
PROXY_NETWORK=web-proxy

# Optional local build behavior (not used on the server pull-only flow)
DOCKERFILE=Dockerfile

# Optional watchtower Docker auth path
# DOCKER_CONFIG_JSON=/root/.docker/config.json
