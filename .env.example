# Local compose / production pull-only compose
HARBOR_REGISTRY=harbor.example.com
HARBOR_PROJECT=zenora
IMAGE_TAG=latest
# Prefer full ref. Production deploy sets IMAGE_REF=registry/project/name@sha256:...
IMAGE_REF=harbor.example.com/zenora/zenora-web:latest

# Production (NPM): Docker network shared with Nginx Proxy Manager
PROXY_NETWORK=web-proxy

# Local only (with docker-compose.local.yml): host port → container :8080
WEB_HOST_PORT=8080

# Dockerfile = full multi-stage (standard path for CI / release)
# Dockerfile.runtime = nginx-only fallback, requires local `npm ci && npm run build` first
DOCKERFILE=Dockerfile

# Optional OCI labels at build time
# BUILD_DATE=2026-07-25T00:00:00Z
# VCS_REF=abcdef

# Path to Docker config with Harbor credentials (Watchtower profile)
# DOCKER_CONFIG_JSON=~/.docker/config.json
